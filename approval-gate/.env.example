# Multica self-host backend
MULTICA_URL=ws://localhost:8080/ws
MULTICA_HTTP_URL=http://localhost:8080
MULTICA_TOKEN=                  # Personal access token from Multica settings
MULTICA_WORKSPACE_ID=           # Workspace UUID from multica workspace list

# Telegram — approval notifications via Bot API
# 1. Create a bot with @BotFather → get TELEGRAM_BOT_TOKEN
# 2. Message the bot once, then get your chat ID:
#    curl "https://api.telegram.org/bot<TOKEN>/getUpdates" | python3 -m json.tool
TELEGRAM_BOT_TOKEN=             # e.g. 123456789:AAF...
TELEGRAM_CHAT_ID=               # e.g. 987654321 (your personal chat ID with the bot)

# Approver identity (used in audit log comments)
APPROVER_NAME=                  # e.g. Alessandro

# Approval gate HTTP server
GATE_BASE_URL=http://localhost:4242   # Public URL the magic link points to
GATE_PORT=4242

# JWT signing for magic links
JWT_SECRET=                     # openssl rand -hex 32
MULTICA_AGENT_ID=               # UUID from: multica agent list

NODE_ENV=development
